# vLLM endpoints (OpenAI-compatible)
AGENT_BASE_URL=http://localhost:8000/v1
AGENT_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16
TRIAGE_BASE_URL=http://localhost:8001/v1
TRIAGE_MODEL=stormdesk-triage

# 1 = stub model responses so the UI/tools run without a GPU
STORMDESK_MOCK_LLM=0

# Local storage
STORMDESK_DB=data/stormdesk.db
ROAD_GRAPH=data/cache/road_graph.graphml

# Contact for api.weather.gov User-Agent (they ask for one)
NWS_USER_AGENT=StormDesk hackathon (your-email@example.com)

# DriveNC developer key for sync/sync_ncdot.py (free, from drivenc.gov)
DRIVENC_API_KEY=
